# Copy to .env and edit. Never commit .env.

# LLM (Ollama, OpenAI-compatible endpoint)
OLLAMA_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
NUM_CTX=8192

# Web search. Offline demo: http://localhost:8000/web/search.html?q={q}
SEARCH_URL=https://html.duckduckgo.com/html/?q={q}

# Autonomy. BLOCKED_DOMAINS is a comma-separated list.
MAX_STEPS=30
MAX_FAILURES=2
BLOCKED_DOMAINS=

# Voice. STT_BACKEND: handy | whisper. TTS_BACKEND: piper | browser.
STT_BACKEND=handy
TTS_BACKEND=browser
# Path to a Piper .onnx voice (needed only for TTS_BACKEND=piper)
PIPER_VOICE=

# Gate. GATE_BACKEND: jev | llm | rules. Thresholds: proceed >= GATE_PROCEED, block < GATE_ASK.
GATE_BACKEND=rules
GATE_PROCEED=0.85
GATE_ASK=0.5
# Jev credentials, per docs/JEV_NOTES.md (M4)
JEV_API_KEY=
